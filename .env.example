# 环境变量模板
# 复制本文件为 .env 并填入真实密钥。
# .env 已被 .gitignore 排除，不会被提交到 GitHub。

# ---- 密钥 ----
# 申请地址：https://platform.deepseek.com/api_keys
# 若实验室统一提供密钥，直接填入其给定的字符串即可。
DEEPSEEK_API_KEY=sk-在这里填入你的真实密钥

# ---- 接口地址 ----
# 默认走 DeepSeek 官方端点。
# 若实验室提供内部代理或专用端点，替换为对应地址。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 模型 ----
# 推荐 deepseek-flash（实际版本 DeepSeek-V4.1-Flash，上下文 1M）
# 注意：旧模型名 deepseek-v4-flash 已退役，不要使用
DEEPSEEK_MODEL=deepseek-flash
